# ==============================================================================
# MADECC GROUP - Production cPanel & Apache / LiteSpeed Configuration (.htaccess)
# Designed for high-performance SPA routing, Google Play Store TWA, and AdSense
# ==============================================================================

# Disable directory browsing
Options -Indexes

# Set default character set
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ----------------------------------------------------------------------------
  # 1. Force HTTPS (Strict SSL on cPanel / Let's Encrypt / AutoSSL)
  # ----------------------------------------------------------------------------
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ----------------------------------------------------------------------------
  # 2. Allow Direct Access to Static Assets, Verification Files & APIs
  # ----------------------------------------------------------------------------
  # Allow Google Play Store Digital Asset Links
  RewriteRule ^\.well-known/assetlinks\.json$ - [L]
  # Allow robots, sitemaps, ads.txt, manifests
  RewriteRule ^(robots\.txt|sitemap\.xml|ads\.txt|manifest\.json)$ - [L]

  # ----------------------------------------------------------------------------
  # 3. Single Page Application (SPA) Routing Fallback
  # Redirect all deep links (/about, /services, /projects, /blog, /terms, etc.)
  # to /index.html so React Router & browser history manage the views.
  # ----------------------------------------------------------------------------
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# ------------------------------------------------------------------------------
# 4. Correct MIME Types
# ------------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/manifest+json   .webmanifest .json
  AddType application/ld+json         .jsonld
  AddType image/svg+xml               .svg
  AddType image/webp                  .webp
  AddType font/woff                   .woff
  AddType font/woff2                  .woff2
</IfModule>

# ------------------------------------------------------------------------------
# 5. GZIP / Brotli Compression (High PageSpeed score & fast Play Store load)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ------------------------------------------------------------------------------
# 6. Browser Caching Rules (Leverage Browser Caching via mod_expires)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 2 days"

  # HTML & App Shell (always re-validate so visitors get latest releases)
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 1 week"

  # Media: Images, Icons, Video
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # CSS, JavaScript & Webfonts
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ------------------------------------------------------------------------------
# 7. Production Security & Policy Headers
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Prevent MIME sniffing
  Header set X-Content-Type-Options "nosniff"
  # Clickjacking defense (allows embedding on same origin)
  Header set X-Frame-Options "SAMEORIGIN"
  # XSS protection
  Header set X-XSS-Protection "1; mode=block"
  # Referrer policy for privacy & ad networks
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # Allow cross-origin requests for manifest & assetlinks
  <FilesMatch "\.(webmanifest|json)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

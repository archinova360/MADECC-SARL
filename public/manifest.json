{
  "id": "/",
  "name": "MADECC GROUP - Engineering, Construction & Tech",
  "short_name": "MADECC Group",
  "description": "Cameroon's premier civil engineering, construction management, and architectural enterprise delivering world-class infrastructure.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "tabbed",
    "window-controls-overlay",
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "tab_strip": {
    "home_tab": {
      "scope_url": "/"
    },
    "new_tab_button": {
      "url": "/budget-calculator"
    }
  },
  "orientation": "portrait-primary",
  "theme_color": "#0f172a",
  "background_color": "#0f172a",
  "dir": "ltr",
  "lang": "en",
  "categories": ["business", "productivity", "utilities"],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ec4e53b7",
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "scope_extensions": [
    { "origin": "https://*.madeccgroup.online" },
    { "origin": "https://madeccgroup.online" },
    { "origin": "https://www.madeccgroup.online" },
    { "origin": "https://app.madeccgroup.online" }
  ],
  "file_handlers": [
    {
      "action": "/services",
      "name": "Civil Engineering & CAD Documents",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "accept": {
        "application/pdf": [".pdf"],
        "application/json": [".json"],
        "text/csv": [".csv"],
        "image/*": [".png", ".jpg", ".jpeg", ".webp", ".svg"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+madecc",
      "url": "/?protocol=%s"
    },
    {
      "protocol": "web+boq",
      "url": "/budget-calculator?boq=%s"
    },
    {
      "protocol": "web+tender",
      "url": "/tenders?tender=%s"
    }
  ],
  "share_target": {
    "action": "/request-a-quote",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "widgets": [
    {
      "name": "MADECC Cost Estimator Widget",
      "short_name": "Cost Estimator",
      "description": "Live construction cost calculator and regional material price benchmarks",
      "tag": "madecc-estimator-widget",
      "template": "widget-template",
      "ms_ac_template": "/widget-template.json",
      "data": "/api/widget/data",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/screenshot-narrow.png",
          "sizes": "720x1280",
          "label": "Estimator Widget Preview"
        }
      ],
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192"
        }
      ],
      "auth": false,
      "update": 86400
    }
  ],
  "note_taking": {
    "new_note_url": "/booking?type=site_notes"
  },
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "MADECC GROUP Civil Engineering & Construction Management Dashboard"
    },
    {
      "src": "/screenshot-narrow.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "MADECC Mobile Project Budget Estimator & Services Portal"
    }
  ],
  "shortcuts": [
    {
      "name": "Services & Engineering",
      "short_name": "Services",
      "description": "Explore structural, civil, architectural, and survey engineering services",
      "url": "/services",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Project Portfolio",
      "short_name": "Projects",
      "description": "View completed commercial, residential, and infrastructure works",
      "url": "/projects",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Budget Estimator",

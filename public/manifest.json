      "id": "online.madeccgroup.twa"
    },
    {
      "platform": "webapp",
      "url": "https://madeccgroup.online/manifest.json"
    }
  ],
  "prefer_related_applications": false,
  "handle_links": "preferred",
  "edge_side_panel": {
    "preferred_width": 480
  }
